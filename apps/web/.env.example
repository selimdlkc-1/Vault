# apps/web ortam değişkenleri (lokal `.env.local` olarak kopyalanır).
# Tüm değerler lokal-sabittir; dışarıdan secret temini gerekmez.

# Next.js'in `/api/v1/*` isteklerini proxy'lediği backend adresi.
# Lokal `pnpm dev`: http://localhost:3001 (varsayılan, boş bırakılabilir).
# Docker Compose: http://api:3001 (compose servis adı).
API_PROXY_TARGET=http://localhost:3001
