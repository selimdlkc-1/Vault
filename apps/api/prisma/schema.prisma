// Vault — Prisma şeması.
// Tek doğruluk kaynağı: docs/02_DATABASE_SCHEMA.md.
// Faz 0 §0.3: users, networks, assets, network_assets.
// Faz 1 §1.3: refresh_tokens (SEC-013) — rotating refresh cookie + replay tespiti.
// Faz 3 §3.1: wallets. Faz 3 §3.2: balance_caches (balance-sync worker'ın yazdığı
// bakiye önbelleği — RPC asla sayfa yüklemesinde çağrılmaz, mimari-kararlar I-003).
// Faz 3 §3.4b: portfolio_snapshots (portfolio-snapshot worker'ının periyodik yazdığı
// toplam portföy değeri anlık görüntüsü — geçmiş grafiği bundan okunur, sorgu
// anında yeniden hesaplanmaz, mimari-kararlar P-016).
// Faz 3 §3.6a: chain_movements (movement-index worker'ının Alchemy webhook + Tron
// polling ile indexlediği ham zincir hareket kaydı — GET /movements bu fazda
// yalnızca bu kaynağı döner, transfers birleşimi Faz 5, mimari-kararlar W-006).
// Faz 4 §4.4b: mint_operations (admin'in POST /admin/mint ile bir kullanıcı
// cüzdanına mock ERC-20/TRC-20 test bakiyesi dağıtma işlemi — mock kontratın
// mint() fonksiyonu gerçekten çağrılır, sonuç mint_operations + audit_logs'a tek
// transaction içinde yazılır; bir Transfer kaydı değildir, ayrı bir varlıktır —
// docs/01_DOMAIN_MODEL.md §2.10, docs/02_DATABASE_SCHEMA.md §2.11).
// Diğer tablolar sonraki fazlarda eklenir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum ChainType {
  evm
  tron

  @@map("chain_type")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

enum WalletType {
  watch_only
  managed

  @@map("wallet_type")
}

enum MovementDirection {
  incoming
  outgoing

  @@map("movement_direction")
}

/// docs/01_DOMAIN_MODEL.md §5.2 — transfer durum makinesinin 8 durumu; üçü
/// terminaldir (`confirmed`/`failed`/`dropped`). Postgres enum tipi yalnızca
/// geçersiz string'i engeller; izin verilen geçiş mantığı `TransferStateMachine`
/// servisindedir (`.claude/rules/13-critical-modules.md`, mimari-kararlar W-004).
enum TransferState {
  draft
  pending_signature
  signed
  broadcast
  confirming
  confirmed
  failed
  dropped

  @@map("transfer_state")
}

/// docs/02_DATABASE_SCHEMA.md §2.1
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  wallets            Wallet[]
  portfolioSnapshots PortfolioSnapshot[]
  mintOperations     MintOperation[] @relation("MintOperationAdmin")

  @@map("users")
}

/// docs/02_DATABASE_SCHEMA.md §2.13 — rotating refresh token oturum kaydı (mimari-kararlar SEC-013).
/// Satır silinmez; rotation/logout/replay tespitinde `revoked_at` doldurulur (tombstone).
/// `token_hash` = ham token'ın `JWT_REFRESH_SECRET` anahtarlı HMAC-SHA256'sı (argon2id değil — doğrudan lookup).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// docs/02_DATABASE_SCHEMA.md §2.2
model Network {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  chainType              ChainType @map("chain_type")
  chainId                String   @unique @map("chain_id")
  confirmationThreshold  Int      @map("confirmation_threshold")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  assets        Asset[]
  networkAssets NetworkAsset[]
  wallets       Wallet[]
  transfers     Transfer[]

  @@map("networks")
}

/// docs/02_DATABASE_SCHEMA.md §2.3
model Asset {
  id              String   @id @default(uuid()) @db.Uuid
  networkId       String   @map("network_id") @db.Uuid
  symbol          String
  decimals        Int
  contractAddress String?  @map("contract_address")
  coingeckoId     String   @map("coingecko_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  network        Network         @relation(fields: [networkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  networkAssets  NetworkAsset[]
  balanceCaches  BalanceCache[]
  chainMovements ChainMovement[]
  mintOperations MintOperation[]
  transfers      Transfer[]

  @@unique([networkId, symbol])
  @@map("assets")
}

/// docs/02_DATABASE_SCHEMA.md §2.4 — Network/Asset aktivasyon join tablosu (AUTH-003).
model NetworkAsset {
  networkId    String    @map("network_id") @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  isActive     Boolean   @default(false) @map("is_active")
  activatedAt  DateTime? @map("activated_at") @db.Timestamptz

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([networkId, assetId])
  @@map("network_assets")
}

/// docs/02_DATABASE_SCHEMA.md §2.5 — kullanıcının portföyünü oluşturan cüzdanlar.
/// Faz 3 §3.1: `watch_only` oluşturma yolu. Faz 4 §4.2: `managed` cüzdan türetme —
/// `encrypted_private_key` kolonu bu additive migration'da eklenir (Faz 3'te
/// `wallets` ilk oluşturulduğunda yalnızca `encrypted_dek` vardı, envelope
/// encryption'ın ikinci katmanı için eksikti; mevcut watch-only satırları
/// etkilenmez — `docs/02` §2.5, `docs/mimari-kararlar.md` SEC-006).
/// `type = 'watch_only'` iken `derivation_index`, `encrypted_dek` ve
/// `encrypted_private_key` `NULL` kalmalıdır — Prisma koşullu CHECK
/// desteklemediğinden bu kural servis katmanında (`WalletsService`) zorlanır.
model Wallet {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @map("user_id") @db.Uuid
  networkId           String     @map("network_id") @db.Uuid
  type                WalletType
  address             String
  derivationIndex     Int?       @map("derivation_index")
  encryptedDek        String?    @map("encrypted_dek")
  encryptedPrivateKey String?    @map("encrypted_private_key")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  network Network @relation(fields: [networkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  balanceCaches  BalanceCache[]
  chainMovements ChainMovement[]
  mintOperations MintOperation[]
  transfers      Transfer[]

  @@unique([networkId, address])
  @@index([userId], map: "wallets_user_id_idx")
  @@index([networkId], map: "wallets_network_id_idx")
  @@map("wallets")
}

/// docs/02_DATABASE_SCHEMA.md §2.6 — `balance-sync` worker'ının her aktif
/// `(wallet, asset)` çifti için RPC/TronGrid'den okuyup yazdığı bakiye önbelleği.
/// `balance_raw` en küçük birimde (wei/sun) BigInt string'idir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, mimari-kararlar P-015). UI bu tablodan
/// okur, hiçbir sayfa yüklemesi RPC çağırmaz (mimari-kararlar I-003).
model BalanceCache {
  walletId   String   @map("wallet_id") @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  balanceRaw String   @default("0") @map("balance_raw")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([walletId, assetId])
  @@map("balance_caches")
}

/// docs/02_DATABASE_SCHEMA.md §2.14 — `portfolio-snapshot` worker'ının periyodik
/// yazdığı toplam portföy değeri anlık görüntüsü. Append-only: hiçbir satır
/// güncellenmez veya silinmez; `GET /portfolio/history` doğrudan bu tablodan
/// okur, sorgu anında yeniden hesaplamaz (`docs/mimari-kararlar.md` P-016).
/// `total_value_usdt` `DECIMAL(38,18)` sabit hassasiyettir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, `docs/mimari-kararlar.md` P-015).
model PortfolioSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  totalValueUsdt Decimal  @map("total_value_usdt") @db.Decimal(38, 18)
  priceSource    String   @default("coingecko") @map("price_source")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "portfolio_snapshots_user_id_created_at_idx")
  @@map("portfolio_snapshots")
}

/// docs/02_DATABASE_SCHEMA.md §2.9 — `movement-index` worker'ının (Alchemy webhook
/// EVM / TronGrid polling Tron, mimari-kararlar I-002) indexlediği ham zincir
/// hareket kaydı; watch-only dahil tüm cüzdan tipleri için tutulur. Append-only:
/// hiçbir satır güncellenmez veya silinmez (yalnızca `created_at`/`occurred_at`).
/// `amount` en küçük birimde (wei/sun) BigInt string'idir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, mimari-kararlar P-015). `(wallet_id,
/// tx_hash, direction)` UNIQUE: aynı worker taraması / tekrar tetiklenen webhook
/// aynı hareketi iki kez yazamaz (idempotent indexleme).
model ChainMovement {
  id         String            @id @default(uuid()) @db.Uuid
  walletId   String            @map("wallet_id") @db.Uuid
  assetId    String            @map("asset_id") @db.Uuid
  txHash     String            @map("tx_hash")
  direction  MovementDirection
  amount     String
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([walletId, txHash, direction], map: "chain_movements_wallet_id_tx_hash_direction_key")
  @@index([walletId, occurredAt(sort: Desc)], map: "chain_movements_wallet_id_occurred_at_idx")
  @@index([txHash], map: "chain_movements_tx_hash_idx")
  @@map("chain_movements")
}

/// docs/02_DATABASE_SCHEMA.md §2.11 — admin'in bir kullanıcı cüzdanına mock
/// ERC-20/TRC-20 test bakiyesi dağıtma (mint) işlemi (docs/01_DOMAIN_MODEL.md
/// §2.10 MintOperation). Append-only: hiçbir satır güncellenmez veya silinmez
/// (yalnızca `created_at`). Bir `Transfer` kaydı değildir — `transfers`'a hiç
/// dokunmaz. `amount` en küçük birimde (decimals'a göre) BigInt string'idir —
/// asla JS `number` (`.claude/rules/15-backend-data.md`, mimari-kararlar P-015).
/// `mint_operations` yazımı + `audit_logs` (`MINT_EXECUTED`) yazımı tek
/// `$transaction` içinde yapılır (`docs/04_BACKEND_SPEC.md` §7).
model MintOperation {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  walletId  String   @map("wallet_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  amount    String
  txHash    String?  @map("tx_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin  User   @relation("MintOperationAdmin", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([walletId], map: "mint_operations_wallet_id_idx")
  @@map("mint_operations")
}

/// docs/02_DATABASE_SCHEMA.md §2.7 / docs/01_DOMAIN_MODEL.md §2.6 — yalnızca
/// managed cüzdanlardan başlatılan, zincire imzalı işlem gönderen sistem içi
/// transfer ve durum makinesi. `wallet_id` yalnızca `type = 'managed'` bir cüzdanı
/// referans alabilir (application-layer kontrol — `TransfersService`). `amount` en
/// küçük birimde (wei/sun) BigInt string'idir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, mimari-kararlar P-015).
///
/// `state` alanına yazan **tek** kod yolu `TransferStateMachine` servisidir
/// (mimari-kararlar W-003/W-004, `.claude/rules/13-critical-modules.md`); hiçbir
/// controller/repository/worker bu alana doğrudan `UPDATE` uygulamaz.
///
/// `idempotency_key` — `POST /transfers`'ün zorunlu `Idempotency-Key` header'ı
/// (istemcinin ürettiği UUID). `(wallet_id, idempotency_key)` UNIQUE: aynı anahtarla
/// gelen çift gönderim / retry ikinci bir transfer oluşturamaz (`docs/03` §7,
/// mimari-kararlar I-005 istemci-tarafı idempotency). `NULL` anahtarlar birbiriyle
/// çakışmaz (Postgres NULLS DISTINCT) — bu fazda her satır dolu bir anahtar taşır.
model Transfer {
  id             String        @id @default(uuid()) @db.Uuid
  walletId       String        @map("wallet_id") @db.Uuid
  networkId      String        @map("network_id") @db.Uuid
  assetId        String        @map("asset_id") @db.Uuid
  toAddress      String        @map("to_address")
  amount         String
  state          TransferState @default(draft)
  txHash         String?       @map("tx_hash")
  failureReason  String?       @map("failure_reason")
  idempotencyKey String?       @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  wallet  Wallet  @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  network Network @relation(fields: [networkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  stateEvents TransferStateEvent[]

  @@unique([walletId, idempotencyKey], map: "transfers_wallet_id_idempotency_key_key")
  @@index([walletId], map: "transfers_wallet_id_idx")
  @@index([state], map: "transfers_state_idx")
  @@index([txHash], map: "transfers_tx_hash_idx")
  @@map("transfers")
}

/// docs/02_DATABASE_SCHEMA.md §2.8 / docs/01_DOMAIN_MODEL.md §2.7 — bir transferin
/// her durum geçişinin append-only denetim izi; hiçbir satır güncellenmez veya
/// silinmez (yalnızca `occurred_at`). İlk kayıt `from_state = NULL` (giriş durumu)
/// taşır. `actor` serbest metindir ama uygulama katmanında sabit bir liste ile
/// sınırlanır (`'user'` | `'system'` | `'worker:signing'` | `'worker:broadcast'` |
/// `'worker:confirmation'`). `TransferStateMachine` her geçişte bir satır ekler —
/// bu tablo state machine servisi dışından yazılmaz.
model TransferStateEvent {
  id         String         @id @default(uuid()) @db.Uuid
  transferId String         @map("transfer_id") @db.Uuid
  fromState  TransferState?  @map("from_state")
  toState    TransferState   @map("to_state")
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz
  actor      String
  metadata   Json?

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([transferId], map: "transfer_state_events_transfer_id_idx")
  @@map("transfer_state_events")
}

/// docs/02_DATABASE_SCHEMA.md §2.12 — uygulama seviyesi denetim izi.
/// Append-only: hiçbir satır güncellenmez veya silinmez (yalnızca `created_at`).
/// `AuditService.record()` bir `Prisma.TransactionClient` alarak çağıranın
/// transaction'ına katılır — audit yazımı iş işleminin ayrılmaz parçasıdır
/// (`docs/04_BACKEND_SPEC.md` §7). `entity_type`/`entity_id` kasıtlı olarak FK
/// değildir (zayıf referans — farklı tablolara işaret edebilir).
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorType, actorId], map: "audit_logs_actor_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}
