// Vault — Prisma şeması.
// Tek doğruluk kaynağı: docs/02_DATABASE_SCHEMA.md.
// Faz 0 §0.3: users, networks, assets, network_assets.
// Faz 1 §1.3: refresh_tokens (SEC-013) — rotating refresh cookie + replay tespiti.
// Faz 3 §3.1: wallets. Faz 3 §3.2: balance_caches (balance-sync worker'ın yazdığı
// bakiye önbelleği — RPC asla sayfa yüklemesinde çağrılmaz, mimari-kararlar I-003).
// Faz 3 §3.4b: portfolio_snapshots (portfolio-snapshot worker'ının periyodik yazdığı
// toplam portföy değeri anlık görüntüsü — geçmiş grafiği bundan okunur, sorgu
// anında yeniden hesaplanmaz, mimari-kararlar P-016).
// Faz 3 §3.6a: chain_movements (movement-index worker'ının Alchemy webhook + Tron
// polling ile indexlediği ham zincir hareket kaydı — GET /movements bu fazda
// yalnızca bu kaynağı döner, transfers birleşimi Faz 5, mimari-kararlar W-006).
// Diğer tablolar sonraki fazlarda eklenir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum ChainType {
  evm
  tron

  @@map("chain_type")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

enum WalletType {
  watch_only
  managed

  @@map("wallet_type")
}

enum MovementDirection {
  incoming
  outgoing

  @@map("movement_direction")
}

/// docs/02_DATABASE_SCHEMA.md §2.1
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  wallets            Wallet[]
  portfolioSnapshots PortfolioSnapshot[]

  @@map("users")
}

/// docs/02_DATABASE_SCHEMA.md §2.13 — rotating refresh token oturum kaydı (mimari-kararlar SEC-013).
/// Satır silinmez; rotation/logout/replay tespitinde `revoked_at` doldurulur (tombstone).
/// `token_hash` = ham token'ın `JWT_REFRESH_SECRET` anahtarlı HMAC-SHA256'sı (argon2id değil — doğrudan lookup).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// docs/02_DATABASE_SCHEMA.md §2.2
model Network {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  chainType              ChainType @map("chain_type")
  chainId                String   @unique @map("chain_id")
  confirmationThreshold  Int      @map("confirmation_threshold")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  assets        Asset[]
  networkAssets NetworkAsset[]
  wallets       Wallet[]

  @@map("networks")
}

/// docs/02_DATABASE_SCHEMA.md §2.3
model Asset {
  id              String   @id @default(uuid()) @db.Uuid
  networkId       String   @map("network_id") @db.Uuid
  symbol          String
  decimals        Int
  contractAddress String?  @map("contract_address")
  coingeckoId     String   @map("coingecko_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  network        Network         @relation(fields: [networkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  networkAssets  NetworkAsset[]
  balanceCaches  BalanceCache[]
  chainMovements ChainMovement[]

  @@unique([networkId, symbol])
  @@map("assets")
}

/// docs/02_DATABASE_SCHEMA.md §2.4 — Network/Asset aktivasyon join tablosu (AUTH-003).
model NetworkAsset {
  networkId    String    @map("network_id") @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  isActive     Boolean   @default(false) @map("is_active")
  activatedAt  DateTime? @map("activated_at") @db.Timestamptz

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([networkId, assetId])
  @@map("network_assets")
}

/// docs/02_DATABASE_SCHEMA.md §2.5 — kullanıcının portföyünü oluşturan cüzdanlar.
/// Faz 3 §3.1: yalnızca `watch_only` oluşturma yolu var; `managed` cüzdan
/// türetme + `encrypted_private_key` kolonu Faz 4 §4.1/§4.2'de eklenir.
/// `type = 'watch_only'` iken `derivation_index` ve `encrypted_dek` `NULL`
/// kalmalıdır — Prisma koşullu CHECK desteklemediğinden bu kural servis
/// katmanında (`WalletsService`) zorlanır (`docs/02` §2.5 notu).
model Wallet {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  networkId       String     @map("network_id") @db.Uuid
  type            WalletType
  address         String
  derivationIndex Int?       @map("derivation_index")
  encryptedDek    String?    @map("encrypted_dek")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  network Network @relation(fields: [networkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  balanceCaches  BalanceCache[]
  chainMovements ChainMovement[]

  @@unique([networkId, address])
  @@index([userId], map: "wallets_user_id_idx")
  @@index([networkId], map: "wallets_network_id_idx")
  @@map("wallets")
}

/// docs/02_DATABASE_SCHEMA.md §2.6 — `balance-sync` worker'ının her aktif
/// `(wallet, asset)` çifti için RPC/TronGrid'den okuyup yazdığı bakiye önbelleği.
/// `balance_raw` en küçük birimde (wei/sun) BigInt string'idir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, mimari-kararlar P-015). UI bu tablodan
/// okur, hiçbir sayfa yüklemesi RPC çağırmaz (mimari-kararlar I-003).
model BalanceCache {
  walletId   String   @map("wallet_id") @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  balanceRaw String   @default("0") @map("balance_raw")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([walletId, assetId])
  @@map("balance_caches")
}

/// docs/02_DATABASE_SCHEMA.md §2.14 — `portfolio-snapshot` worker'ının periyodik
/// yazdığı toplam portföy değeri anlık görüntüsü. Append-only: hiçbir satır
/// güncellenmez veya silinmez; `GET /portfolio/history` doğrudan bu tablodan
/// okur, sorgu anında yeniden hesaplamaz (`docs/mimari-kararlar.md` P-016).
/// `total_value_usdt` `DECIMAL(38,18)` sabit hassasiyettir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, `docs/mimari-kararlar.md` P-015).
model PortfolioSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  totalValueUsdt Decimal  @map("total_value_usdt") @db.Decimal(38, 18)
  priceSource    String   @default("coingecko") @map("price_source")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "portfolio_snapshots_user_id_created_at_idx")
  @@map("portfolio_snapshots")
}

/// docs/02_DATABASE_SCHEMA.md §2.9 — `movement-index` worker'ının (Alchemy webhook
/// EVM / TronGrid polling Tron, mimari-kararlar I-002) indexlediği ham zincir
/// hareket kaydı; watch-only dahil tüm cüzdan tipleri için tutulur. Append-only:
/// hiçbir satır güncellenmez veya silinmez (yalnızca `created_at`/`occurred_at`).
/// `amount` en küçük birimde (wei/sun) BigInt string'idir — asla JS `number`
/// (`.claude/rules/15-backend-data.md`, mimari-kararlar P-015). `(wallet_id,
/// tx_hash, direction)` UNIQUE: aynı worker taraması / tekrar tetiklenen webhook
/// aynı hareketi iki kez yazamaz (idempotent indexleme).
model ChainMovement {
  id         String            @id @default(uuid()) @db.Uuid
  walletId   String            @map("wallet_id") @db.Uuid
  assetId    String            @map("asset_id") @db.Uuid
  txHash     String            @map("tx_hash")
  direction  MovementDirection
  amount     String
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([walletId, txHash, direction], map: "chain_movements_wallet_id_tx_hash_direction_key")
  @@index([walletId, occurredAt(sort: Desc)], map: "chain_movements_wallet_id_occurred_at_idx")
  @@index([txHash], map: "chain_movements_tx_hash_idx")
  @@map("chain_movements")
}

/// docs/02_DATABASE_SCHEMA.md §2.12 — uygulama seviyesi denetim izi.
/// Append-only: hiçbir satır güncellenmez veya silinmez (yalnızca `created_at`).
/// `AuditService.record()` bir `Prisma.TransactionClient` alarak çağıranın
/// transaction'ına katılır — audit yazımı iş işleminin ayrılmaz parçasıdır
/// (`docs/04_BACKEND_SPEC.md` §7). `entity_type`/`entity_id` kasıtlı olarak FK
/// değildir (zayıf referans — farklı tablolara işaret edebilir).
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorType, actorId], map: "audit_logs_actor_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}
