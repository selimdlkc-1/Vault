# apps/api ortam değişkenleri.
# Bu dosya `apps/api/.env` olarak kopyalanır ve değerler doldurulur (`docs/09_DEV_WORKFLOW.md` §6-7).
# Gerçek secret değeri buraya (veya .env.example'a) asla commit edilmez.
# Doğrulama şeması: src/config/env.schema.ts — eksik/geçersiz bir değişken uygulamayı başlatmaz (fail-fast).

# --- Ortam ---
# NODE_ENV yalnızca development|test alır; "production" hiç kullanılmaz (tek ortam: local).
NODE_ENV=development
LOG_LEVEL=info

# --- Docker Compose'un ürettiği sabit lokal bağlantılar (dışarıdan temin gerekmez) ---
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault
REDIS_URL=redis://localhost:6379

# --- JWT / Session (docs/09 §7 — openssl rand -hex 32 ile geliştirici kendi makinesinde üretir) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# --- Key storage / HD wallet (geliştirici kendi makinesinde rastgele üretir; paylaşılan sabit değer değildir) ---
MASTER_ENCRYPTION_KEY=
HD_WALLET_MNEMONIC=

# --- Mint operator (packages/contracts/.env'deki CONTRACT_DEPLOYER_PRIVATE_KEY ile aynı değer olmalı) ---
MINT_OPERATOR_PRIVATE_KEY=

# --- Testnet RPC uç noktaları (Alchemy/Infura vb. ücretsiz geliştirici hesabından) ---
SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=
TRON_SHASTA_RPC_URL=

# --- Sağlayıcı API anahtarları ---
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=
TRONGRID_API_KEY=
# CoinGecko public API tier'ı için boş bırakılabilir.
COINGECKO_API_KEY=

# --- Sabit değerler (dışarıdan temin gerekmez, bu liste genişletilmez) ---
CHAIN_ID_ALLOWLIST=sepolia,bsc-testnet,tron-shasta
CORS_ORIGIN=http://localhost:3000

# Refresh cookie'nin `secure` bayrağı; varsayılan/güvenli davranış true'dur.
# Sistem yalnızca düz http://localhost üzerinde çalıştığından, yalnızca yerel
# geliştirici kendi .env'inde açıkça false yaparak kapatabilir (mimari-kararlar SEC-007/SEC-013).
COOKIE_SECURE=true
